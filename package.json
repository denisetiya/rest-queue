{
  "name": "rest-queue",
  "version": "1.0.1",
  "description": "Zero-dependency, offline-first mutation engine for REST APIs. Features reliable persistence, dependency chaining, automatic retries with backoff, and file upload support.",
  "keywords": [
    "rest-api",
    "offline-first",
    "queue",
    "request-queue",
    "mutation-queue",
    "fetch",
    "retry",
    "backoff",
    "persistence",
    "indexeddb",
    "network-resilience",
    "typescript",
    "zero-dependency",
    "file-upload",
    "resilience"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "test": "vitest --environment happy-dom",
    "lint": "eslint ."
  },
  "author": "denisetiya",
  "repository": {
    "type": "git",
    "url": "https://github.com/denisetiya/sync-later.git"
  },
  "homepage": "https://github.com/denisetiya/sync-later#readme",
  "bugs": {
    "url": "https://github.com/denisetiya/sync-later/issues"
  },
  "license": "ISC",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/node": "^25.0.3",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.11",
    "semantic-release": "^25.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  }
}
